# Copy this file to .env and fill in your values.
#
# The HPG pipeline requires these environment variables. There are no
# hardcoded defaults; the code fails fast if required vars are unset.
# If you're only running the frontend locally (no HPG training), you can
# skip this; the backend will still start.

# SSH alias for HiPerGator (see SETUP.md for ~/.ssh/config example)
FASTERGS_REMOTE=hpg

# Your HPG workspace root. Must be writable by your gatorlink.
FASTERGS_REMOTE_ROOT=/blue/cis4914/YOUR_GATORLINK/gs_final

# OpenSplat install root. Leave empty to default to $FASTERGS_REMOTE_ROOT/src/OpenSplat
FASTERGS_OPENSPLAT_ROOT=

# SLURM account
FASTERGS_SLURM_ACCOUNT=cis4914

# SLURM partitions
FASTERGS_PREP_PARTITION=hpg-default
FASTERGS_TRAIN_PARTITION=hpg-turin

# COLMAP apptainer container on HPG (usually the shared class path)
FASTERGS_COLMAP_CONTAINER=/apps/colmap/3.11/container.sif

# Only needed for hpg_gs_final_sync.py (hpg-to-hpg dataset sync helper)
FASTERGS_SOURCE_DATASETS=/blue/cis4914/YOUR_GATORLINK/gaussian-splatting/experiments/faster-gs/datasets
