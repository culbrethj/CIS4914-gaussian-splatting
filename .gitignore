# --- Python ---
__pycache__/
*.pyc
*.pyo
venv/
.env
.pytest_cache/

# --- Node / Vite ---
node_modules
frontend/dist/

# --- macOS / editor junk ---
**/.DS_Store

# --- Project data dirs (local only, too large for git) ---
data/
database.db
sparse/
backend/datasets
backend/data_output

# Per-dataset intermediate + output artifacts. The `backend/datasets` rule
# above already covers everything inside, but these are listed explicitly
# so new files like `output.ply` / `output.splat` at other paths are also
# caught.
backend/datasets/*/splat.ply
backend/datasets/*/splat.splat
backend/datasets/*/output.ply
backend/datasets/*/output.splat
backend/datasets/*/sparse/
backend/datasets/*/database.db
backend/datasets/*/posthoc_eval/

# --- Local-only OpenSplat post-hoc evaluation tooling ---
# Writes per-dataset eval outputs under backend/datasets/<name>/posthoc_eval/
# (ignored above). The script itself is a local development tool, not part
# of the production pipeline - stays in the working tree, not tracked.
backend/scripts/opensplat_posthoc_eval.py

# --- OpenSplat runtime deps ---
backend/*.dll
backend/*.exe
backend/binaries/*.dll

# --- HiPerGator artifacts (trained splats, build logs, fetched runs) ---
# These are large binaries + SLURM logs. Keep them local only - teammates
# regenerate by running the pipeline.
backend/build_logs/
backend/hipergator/gs_final/
backend/hipergator/*_latest.splat

# --- Trash quarantine (deep clean review area) ---
# Local staging for files flagged during cleanup; reviewed by hand before
# actual deletion. Never committed.
_trash/

# --- Code audit report (transient) ---
CODE_AUDIT.md
ONBOARDING_AUDIT.md
